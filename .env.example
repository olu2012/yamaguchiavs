# AVS-Shipday Integration Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Required API Keys
# ===========================================

# Shipday API Key for delivery management
# Get yours at: https://dashboard.shipday.com/settings/api
SHIPDAY_API_KEY=your_shipday_api_key_here

# AVS (Address Verification Service) Configuration
# Provided by AVS administrator
AVS_VENDOR_ID=your_avs_vendor_id_here
AVS_SUBSCRIPTION_KEY=your_avs_subscription_key_here
AVS_BASE_URL=https://alat-dev-apim.azure-api.net/customops

# ===========================================
# Service Configuration
# ===========================================

# API Key for authenticating requests to this service
# Generate a secure random string for production
API_KEY=your_service_api_key_here

# Shipday webhook signature secret (for verifying webhook authenticity)
# Configure in Shipday dashboard under webhook settings
SHIPDAY_WEBHOOK_SECRET=your_webhook_secret_here

# ===========================================
# Server Settings
# ===========================================

# Port for the Flask server (default: 5000)
PORT=5000

# Flask debug mode (set to false in production)
FLASK_DEBUG=false

# Allowed CORS origins (comma-separated, use * for all)
CORS_ORIGINS=*

# ===========================================
# Optional Settings
# ===========================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Database URL (if using persistent storage)
# DATABASE_URL=postgresql://user:password@host:5432/database

# Redis URL (if using caching or queues)
# REDIS_URL=redis://localhost:6379/0
